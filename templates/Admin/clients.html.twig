{# niveau 3 #}
{% extends 'Layouts/layout_vente.html.twig' %}

{% block title %}Gestion des clients{% endblock %}

{% block vue %}
    <h1>Tous les clients du site</h1>
    <table>
        <thead>
        <tr>
            <th>Identifiant</th>
            <th>Mot de passe</th>
            <th>Prénom</th>
            <th>Nom</th>
            <th>Date de naissance</th>
            <th>Statut</th>
            <th>Pays</th>
        </tr>
        </thead>
        <tbody>
        {% for client in clients %}
            <tr>
                <td>{{ client.login }}</td>
                <td>{{ client.password }}</td>
                <td>{{ client.name }}</td>
                <td>{{ client.surname }}</td>
                {% set bday = client.birthday ? client.birthday |date('d/m/Y') : 'Non renseigné' %}
                <td>{{ bday }}</td>
                <td>
                    {% for role in client.roles %}
                        [{{ role }}]
                    {% endfor %}
                </td>
                <td>{{ client.country.name }} ({{ client.country.code }})</td>
                {% if app.user.id is not same as(client.id) and 'ROLE_ADMIN' not in client.roles and 'ROLE_SUPER_ADMIN' not in client.roles %}
                <td><button onclick="window.location.href='{{ path('admin_delete', {id: client.id}) }}'">Supprimer</button></td>
                {% endif %}
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
