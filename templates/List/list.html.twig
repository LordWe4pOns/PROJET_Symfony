{% extends 'base.html.twig' %}

{% block title %}Liste des Produits{% endblock %}

{% block body %}
    <h1>Liste des Produits du site</h1>

    <table>
        <thead>
        <tr>
            <th>Nom du booster</th>
            <th>Prix à l'unité</th>
            <th>Stock restant</th>
            <th>Quantité</th>
        </tr>
        </thead>
        <tbody>
        {% for boosters in boosters %}
            <tr>
                <td>{{ boosters.name }}</td>
                <td>{{ boosters.price }} €</td>
                <td>{{ boosters.stock }}</td>
                <td>
                    <form action="{{ path('cart_add', { 'id': boosters.id }) }}" method="post">
                        <input type="hidden" name="boosters_id" value="{{ boosters.id }}">

                        <label for="quantite_{{ boosters.id }}">Quantité :</label>
                        <select name="quantite" id="quantite_{{ boosters.id }}">
                            {% for i in range(1, boosters.stock) %}
                                <option value="{{ i }}">{{ i }}</option>
                            {% endfor %}
                        </select>

                        <button type="submit">Ajouter au panier</button>
                    </form>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
