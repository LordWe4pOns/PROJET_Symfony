{# menu #}
<nav>
    <ul>
    {% if app.user %}
        <li><a href="{{ path('main') }}">Accueil</a></li>
        <li><a href="{{ path('user_profile') }}">Gérer le profil</a></li>
        {% if is_granted('ROLE_USER') %}
            <li><a href="{{ path('product_list') }}">Liste des produits</a></li>
            {% set inCart = amount is same as(0) ? '' : ' : ' ~ amount %}
            <li><a href="{{ path('user_cart') }}">Gérer le panier{{ inCart }}</a></li>
        {% endif %}
        {% if is_granted('ROLE_ADMIN') %}
            <li><a href="{{ path('admin_gestion_clients') }}">Gérer les clients</a></li>
            <li><a href="{{ path('admin_add_booster') }}">Créer un produit</a></li>
            <li><a href="https://fr.wikipedia.org/wiki/Pong">Lien vers site extérieur</a></li>
        {% endif %}
        {% if is_granted('ROLE_SUPER_ADMIN') %}
            <li><a href="{{ path('sadmin_edit_admin') }}">Gérer les administrateurs</a></li>
        {% endif %}
        <li><a href="{{ path('security_logout') }}">Déconnexion</a></li>
    {% else %}
        <li><a href="{{ path('main') }}">Accueil</a></li>
        <li><a href="{{ path('security_login') }}">Connexion</a></li>
        <li><a href="{{ path('register') }}">Créer un compte</a></li>
    {% endif %}
    </ul>
</nav>