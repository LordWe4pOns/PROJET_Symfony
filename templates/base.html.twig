<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Mon Site{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('CSS/Style.CSS') }}">
</head>
<body>
<!-- Bandeau supérieur -->
<header>
    <img src="{{ asset('Pictures/bandeau_haut.png') }}" alt="Bandeau haut">
</header>

<!-- Menu -->
<nav>
    <ul>
        {% if app.user %}
            <li><a href="{{ path('main') }}">Accueil</a></li>
            <li><a href="{{ path('user_profile') }}">Gérer le profil</a></li>
            <li><a href="{{ path('list') }}">Lister les produits</a></li>
            <li><a href="{{ path('cart') }}">Gérer le panier</a></li>
            {% if 'ROLE_ADMIN' in app.user.roles %}
                <li><a href="{{ path('user_gestion_clients') }}">Gérer les clients</a></li>
                <li><a href="#####">Créer un produit</a></li>
                <li><a href="https://fr.wikipedia.org/wiki/Pong">Lien vers site extérieur</a></li>
            {% endif %}
            {% if 'ROLE_SUPER_ADMIN' in app.user.roles %}
                <li><a href="########">Gérer les administrateurs</a></li>
            {% endif %}
            <li><a href="{{ path('security_logout') }}">Déconnexion</a></li>
        {% else %}
            <li><a href="{{ path('security_login') }}">Connexion</a></li>
            <li><a href="{{ path('register') }}">Créer un compte</a></li>
        {% endif %}
    </ul>
</nav>

<!-- Contenu -->
<main>
    {% block body %}{% endblock %}
</main>

<!-- Pied de page -->
<footer>
    <br/>
    <img src="{{ asset('Pictures/bandeau_footer.png') }}" alt="bandeau bas">
</footer>
</body>
</html>
