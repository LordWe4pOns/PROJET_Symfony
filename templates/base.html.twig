<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Mon Site{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('CSS/Style.CSS') }}">
</head>
<body>
<!-- Bandeau supérieur -->
<header>
    <img src="{{ asset('Pictures/bandeau_haut.png') }}" alt="Bandeau haut">
</header>

<!-- Menu -->
<nav>
    <ul>
        <li><a href="{{ path('main') }}">Accueil</a></li>
        <li><a href="#"></a>Gérer le profil</li>
        <li><a href="##"></a>Lister les produits</li>
        <li><a href="###"></a>Gérer le panier</li>
        <li><a href="####"></a>Gérer les clients</li>
        <li><a href="#####"></a>Créer un produit</li>
        <li><a href="######"></a>Lien vers site extérieur</li>
        <li><a href="{{ path('user_profile') }}">Gérer son profil</a></li>
        <li><a href="########"></a>Gérer les administrateurs</li>
        {% if app.user %}
            <li><a href="{{ path('security_logout') }}">Déconnexion</a></li>
        {% else %}
            <li><a href="{{ path('security_login') }}">Connexion</a></li>
            <li><a href="{{ path('register') }}">Créer un compte</a></li>
        {% endif %}
    </ul>
</nav>

<!-- Contenu -->
<main>
    {% block body %}{% endblock %}
</main>

<!-- Pied de page -->
<footer>
    <img src="{{ asset('Pictures/bandeau_bas.png') }}" alt="bandeau bas">
</footer>
</body>
</html>
