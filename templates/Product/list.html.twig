{% extends 'base.html.twig' %}

{% block title %}Liste des Produits{% endblock %}

{% block body %}
    <h1>Liste des Produits du site</h1>

    <table>
        <thead>
        <tr>
            <th>Nom du booster</th>
            <th>Prix à l'unité</th>
            <th>Stock restant</th>
            <th>Extension du booster</th>
            <th>Quantité</th>
        </tr>
        </thead>
        <tbody>
        {% for booster in boosters %}
            <tr>
                <td>{{ booster.name }}</td>
                <td>{{ booster.price }} €</td>
                <td>{{ booster.stock }}</td>
                <td>{{ booster.expansionName }}</td>
                <td>
                    {% if booster.id is not same as(0) and booster.stock is not same as(0) %}
                    <form action="{{ path('user_cart_add', { 'id': booster.id }) }}" method="post">
                        <input type="hidden" name="boosters_id" value="{{ booster.id }}">

                        <label for="quantite_{{ booster.id }}">Quantité :</label>
                        <select name="quantite" id="quantite_{{ booster.id }}">
                            {% for i in range(minQuantities.(booster.id), booster.stock) %}
                                <option value="{{ i }}">{{ i }}</option>
                            {% endfor %}
                        </select>

                        <button type="submit">Ajouter au panier</button>
                    </form>
                    {% else %}
                        Rupture de stock
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
