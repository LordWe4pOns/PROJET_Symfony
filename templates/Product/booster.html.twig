{% extends 'base.html.twig' %}

{% block title %}Ajouter un produit{% endblock %}

{% block body %}
    <h1>Ajouter un produit sur le site</h1>

    {{ form_errors(BoosterForm) }}

    {{ form_start(BoosterForm) }}
    {{ form_row(BoosterForm.name) }}
    {{ form_row(BoosterForm.price) }}
    {{ form_row(BoosterForm.stock) }}
    {{ form_row(BoosterForm.expansion) }}
    {{ form_row(BoosterForm.country) }}

    <button type="submit" class="btn">Créer</button>
    {{ form_end(BoosterForm) }}

{% endblock %}